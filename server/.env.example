# ---------------------------------------------------------------------
# AnemiaScan backend — environment template.
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
# ---------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=anemiscan

# Or, if your host gives you one connection string, use this instead:
# DATABASE_URL=postgres://user:pass@host:5432/anemiscan

# JWT — use a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
